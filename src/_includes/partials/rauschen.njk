{%- set t = rauschen[lang] -%}
<h1>{{ title }}</h1>
<p class="muted">{{ t.intro | safe }}</p>

<div class="card rauschen" id="rauschen">
  <div class="rauschen-controls">
    <label class="name-field">
      <span class="muted">{{ t.seed }}</span>
      <input id="rSeed" class="input" type="text" maxlength="40" placeholder="{{ t.placeholder }}" autocomplete="off" spellcheck="false" />
    </label>
    <button class="btn btn-ghost" id="rRandom" type="button">🎲 {{ t.random }}</button>
  </div>

  <div class="rauschen-controls">
    <label class="rauschen-select">
      <span class="muted">{{ t.palette }}</span>
      <select id="rPalette" class="input">
        <option value="auto">{{ t.paletteAuto }}</option>
        {%- for key, name in t.palettes %}
        <option value="{{ key }}">{{ name }}</option>
        {%- endfor %}
      </select>
    </label>
    <label class="rauschen-select">
      <span class="muted">{{ t.style }}</span>
      <select id="rStyle" class="input">
        {%- for key, name in t.styles %}
        <option value="{{ key }}">{{ name }}</option>
        {%- endfor %}
      </select>
    </label>
  </div>

  <figure class="rauschen-figure">
    <canvas id="rCanvas" width="1200" height="1200" role="img" aria-label="{{ t.canvasLabel }}"></canvas>
    <figcaption>
      <strong id="rTitle">&nbsp;</strong>
      <span class="muted" id="rStatus" aria-live="polite"></span>
    </figcaption>
  </figure>

  <div class="rauschen-actions">
    <button class="btn btn-primary" id="rDownload" type="button">{{ t.download }}</button>
    <button class="btn btn-ghost" id="rShare" type="button">{{ t.share }}</button>
  </div>
</div>

<script type="application/json" id="rauschenText">{{ t | dump | safe }}</script>
