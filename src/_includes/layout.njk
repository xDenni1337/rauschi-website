<!doctype html>
{%- set ui = i18n[lang] -%}
{%- set deUrl = translationKey | translationUrl("de", collections.all) -%}
{%- set enUrl = translationKey | translationUrl("en", collections.all) -%}
<html lang="{{ lang }}">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <title>{{ title }} · {{ site.domain }}</title>
  <meta name="description" content="{{ description or kurz or '' }}" />
  <meta name="color-scheme" content="light dark" />
  <meta name="theme-color" content="#faf7f1" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#0b1220" media="(prefers-color-scheme: dark)" />

  <script>
    // Theme so früh wie möglich setzen, damit beim Laden nichts aufblitzt.
    // Gespeichert wird die Wahl ("light" | "dark" | "system"), angewendet der aufgelöste Wert.
    (function () {
      var choice = "system";
      try { choice = localStorage.getItem("site_theme") || "system"; } catch (e) {}
      if (choice !== "light" && choice !== "dark") choice = "system";
      var dark = choice === "dark" ||
        (choice === "system" && window.matchMedia("(prefers-color-scheme: dark)").matches);
      document.documentElement.dataset.theme = dark ? "dark" : "light";
      document.documentElement.dataset.themeChoice = choice;

      // Gewählte Sprache merken: wer Englisch gewählt hat, landet auf der englischen Startseite
      try {
        if (location.pathname === "/" && localStorage.getItem("site_lang") === "en") location.replace("/en/");
      } catch (e) {}
    })();
  </script>

  {%- if translationKey %}
  <link rel="alternate" hreflang="de" href="https://{{ site.domain }}{{ deUrl }}" />
  <link rel="alternate" hreflang="en" href="https://{{ site.domain }}{{ enUrl }}" />
  {%- endif %}

  <link rel="stylesheet" href="/assets/css/style.css" />
</head>

<body>
  <a class="skip-link" href="#content">{{ ui.skip }}</a>

  {%- if lang == "en" -%}
    {%- set home = "/en/" -%}
    {%- set contactUrl = "/en/contact/" -%}
    {%- set navItems = [
      { url: "/en/", label: ui.nav.start },
      { url: "/en/about/", label: ui.nav.about },
      { url: "/en/projects/", label: ui.nav.projects }
    ] -%}
  {%- else -%}
    {%- set home = "/" -%}
    {%- set contactUrl = "/kontakt/" -%}
    {%- set navItems = [
      { url: "/", label: ui.nav.start },
      { url: "/ueber-mich/", label: ui.nav.about },
      { url: "/projekte/", label: ui.nav.projects }
    ] -%}
  {%- endif -%}

  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="{{ home }}" aria-label="{{ ui.home }}">
        <span class="brand-mark">DR</span>
        <span class="brand-text">Denni Rauschenberg</span>
      </a>

      <nav class="nav" aria-label="{{ ui.nav.label }}">
        {%- for item in navItems %}
        {%- set active = (page.url == item.url) or (item.url != home and page.url.startsWith(item.url)) %}
        <a class="nav-link" href="{{ item.url }}"{% if active %} aria-current="page"{% endif %}>{{ item.label }}</a>
        {%- endfor %}
        <a class="nav-link nav-cta" href="{{ contactUrl }}"{% if page.url == contactUrl %} aria-current="page"{% endif %}>{{ ui.nav.contact }}</a>

        <div class="settings">
          <button class="icon-btn" id="settingsBtn" type="button"
            aria-label="{{ ui.settings.button }}" aria-haspopup="true" aria-expanded="false" aria-controls="settingsPanel">
            <svg class="gear" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor"
              stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M10.325 4.317c.426 -1.756 2.924 -1.756 3.35 0a1.724 1.724 0 0 0 2.573 1.066c1.543 -.94 3.31 .826 2.37 2.37a1.724 1.724 0 0 0 1.065 2.572c1.756 .426 1.756 2.924 0 3.35a1.724 1.724 0 0 0 -1.066 2.573c.94 1.543 -.826 3.31 -2.37 2.37a1.724 1.724 0 0 0 -2.572 1.065c-.426 1.756 -2.924 1.756 -3.35 0a1.724 1.724 0 0 0 -2.573 -1.066c-1.543 .94 -3.31 -.826 -2.37 -2.37a1.724 1.724 0 0 0 -1.065 -2.572c-1.756 -.426 -1.756 -2.924 0 -3.35a1.724 1.724 0 0 0 1.066 -2.573c-.94 -1.543 .826 -3.31 2.37 -2.37c1 .608 2.296 .07 2.572 -1.065z"/>
              <circle cx="12" cy="12" r="3"/>
            </svg>
          </button>

          <div class="settings-panel" id="settingsPanel" hidden>
            <p class="settings-title" id="themeLabel">{{ ui.settings.appearance }}</p>
            <div class="segmented" role="radiogroup" aria-labelledby="themeLabel">
              <button type="button" class="segment" role="radio" data-theme-choice="light" aria-checked="false">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="4"/>
                  <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
                </svg>
                <span>{{ ui.settings.light }}</span>
              </button>
              <button type="button" class="segment" role="radio" data-theme-choice="system" aria-checked="false">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="4" width="18" height="12" rx="2"/>
                  <path d="M8 20h8M12 16v4"/>
                </svg>
                <span>{{ ui.settings.system }}</span>
              </button>
              <button type="button" class="segment" role="radio" data-theme-choice="dark" aria-checked="false">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M20.5 14.1A8.5 8.5 0 0 1 9.9 3.5 8.5 8.5 0 1 0 20.5 14.1Z"/>
                </svg>
                <span>{{ ui.settings.dark }}</span>
              </button>
            </div>
            <p class="settings-hint" id="themeHint"></p>

            <p class="settings-title settings-title-gap" id="langLabel">{{ ui.settings.language }}</p>
            <div class="segmented segmented-2" role="group" aria-labelledby="langLabel">
              <a class="segment" href="{{ deUrl }}" hreflang="de" lang="de" data-lang="de"{% if lang == "de" %} aria-current="true"{% endif %}>
                <span class="segment-code" aria-hidden="true">DE</span>
                <span>Deutsch</span>
              </a>
              <a class="segment" href="{{ enUrl }}" hreflang="en" lang="en" data-lang="en"{% if lang == "en" %} aria-current="true"{% endif %}>
                <span class="segment-code" aria-hidden="true">EN</span>
                <span>English</span>
              </a>
            </div>
          </div>
        </div>
      </nav>
    </div>
  </header>

  <main id="content" class="container content">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="container footer-inner">
      <p class="muted">© {{ buildYear }} Denni Rauschenberg</p>
      <p class="footer-links">
        <a href="/impressum/"{% if lang == "en" %} hreflang="de"{% endif %}>{{ ui.footer.imprint }}</a>
        <span class="dot" aria-hidden="true">·</span>
        <a href="/datenschutz/"{% if lang == "en" %} hreflang="de"{% endif %}>{{ ui.footer.privacy }}</a>
      </p>
    </div>
  </footer>

  <script>
  (() => {
    const KEY = "site_theme";
    const UI = {{ ui.settings | dump | safe }};
    const root = document.documentElement;
    const media = window.matchMedia("(prefers-color-scheme: dark)");
    const btn = document.getElementById("settingsBtn");
    const panel = document.getElementById("settingsPanel");
    const hint = document.getElementById("themeHint");
    const segments = [...panel.querySelectorAll("[data-theme-choice]")];

    // ---------- Theme ----------
    function readChoice() {
      try {
        const v = localStorage.getItem(KEY);
        return v === "light" || v === "dark" ? v : "system";
      } catch (e) {
        return "system";
      }
    }

    function render(choice) {
      const dark = choice === "dark" || (choice === "system" && media.matches);
      root.dataset.theme = dark ? "dark" : "light";
      root.dataset.themeChoice = choice;
      segments.forEach((s) => {
        const on = s.dataset.themeChoice === choice;
        s.setAttribute("aria-checked", String(on));
        s.tabIndex = on ? 0 : -1;
      });
      const mode = dark ? UI.modeDark : UI.modeLight;
      hint.textContent = (choice === "system" ? UI.hintSystem : UI.hintFixed).replace("{mode}", mode);
    }

    function setChoice(choice) {
      try {
        if (choice === "system") localStorage.removeItem(KEY);
        else localStorage.setItem(KEY, choice);
      } catch (e) {}
      // Kurze, weiche Überblendung nur beim aktiven Umschalten
      root.classList.add("theme-anim");
      render(choice);
      clearTimeout(setChoice.t);
      setChoice.t = setTimeout(() => root.classList.remove("theme-anim"), 300);
    }

    segments.forEach((s, i) => {
      s.addEventListener("click", () => setChoice(s.dataset.themeChoice));
      s.addEventListener("keydown", (e) => {
        const step = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 }[e.key];
        if (!step) return;
        e.preventDefault();
        const next = segments[(i + step + segments.length) % segments.length];
        next.focus();
        setChoice(next.dataset.themeChoice);
      });
    });

    // Systemwechsel live übernehmen, solange "System" gewählt ist
    media.addEventListener("change", () => {
      if (readChoice() === "system") render("system");
    });
    // Wahl in anderen Tabs synchron halten
    window.addEventListener("storage", (e) => {
      if (e.key === KEY) render(readChoice());
    });

    render(readChoice());

    // ---------- Sprache ----------
    panel.querySelectorAll("[data-lang]").forEach((link) => {
      link.addEventListener("click", () => {
        try { localStorage.setItem("site_lang", link.dataset.lang); } catch (e) {}
      });
    });

    // ---------- Einstellungs-Popover ----------
    function open() {
      panel.hidden = false;
      btn.setAttribute("aria-expanded", "true");
      (segments.find((s) => s.tabIndex === 0) || segments[0]).focus();
    }
    function close(returnFocus) {
      if (panel.hidden) return;
      panel.hidden = true;
      btn.setAttribute("aria-expanded", "false");
      if (returnFocus) btn.focus();
    }

    btn.addEventListener("click", () => (panel.hidden ? open() : close(false)));
    document.addEventListener("click", (e) => {
      if (!panel.contains(e.target) && !btn.contains(e.target)) close(false);
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") close(true);
    });
    panel.addEventListener("focusout", (e) => {
      if (e.relatedTarget && !panel.contains(e.relatedTarget) && e.relatedTarget !== btn) close(false);
    });
  })();
  </script>
</body>
</html>
